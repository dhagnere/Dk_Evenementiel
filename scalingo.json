{
  "name": "dk-evenementiel",
  "description": "DK Événementiel : calendrier des événements, stock et protocole, projets événementiels",
  "repository": "https://github.com/dhagnere/DK_Evenementiel",
  "env": {
    "NODE_ENV": { "value": "production" },
    "JWT_SECRET": { "generator": "secret" },
    "TRUST_PROXY": { "value": "1" },
    "CLIENT_ORIGIN": { "description": "URL publique de l'application, ex. https://dk-evenementiel.osc-fr1.scalingo.io" },
    "APP_URL": { "description": "Même valeur que CLIENT_ORIGIN (liens dans les courriels)" }
  },
  "addons": [{ "plan": "postgresql:postgresql-starter-512" }],
  "formation": { "web": { "amount": 1, "size": "S" } }
}
