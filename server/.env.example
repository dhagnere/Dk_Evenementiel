# Copiez ce fichier en .env et adaptez les valeurs.

# Base PostgreSQL (13 ou plus). Avec `docker compose up -d postgres` :
#   postgres://dk_calendar:dk_calendar@127.0.0.1:5432/dk_calendar
# Hébergeur imposant TLS : ajouter ?sslmode=require à la fin de l'URL.
DATABASE_URL=postgres://dk_calendar:dk_calendar@127.0.0.1:5432/dk_calendar

# Secret utilisé pour signer les sessions (JWT). Générez une valeur aléatoire en production :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changez-moi-en-production

# Port d'écoute du serveur Express
PORT=4000

# Origine autorisée pour les requêtes du frontend (CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development

# URL publique de l'app, utilisée pour construire les liens dans les emails (ex: https://dk-evenementiel.osc-fr1.scalingo.io)
APP_URL=http://localhost:5173

# --- Envoi d'emails (notification des administrateurs à chaque nouvelle demande d'accès) ---
# Laissez SMTP_HOST vide pour désactiver l'envoi réel : les emails seront simplement affichés
# dans les logs serveur (pratique en local sans compte email).
#
# Exemple avec Brevo (gratuit, https://www.brevo.com — SMTP & Emails > SMTP) :
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=<votre identifiant SMTP Brevo>
#   SMTP_PASS=<votre clé SMTP Brevo>
#
# Exemple avec Gmail (nécessite un "mot de passe d'application", pas votre mot de passe Gmail) :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=votre.adresse@gmail.com
#   SMTP_PASS=<mot de passe d'application Gmail>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Adresse "expéditeur" affichée dans les emails envoyés
EMAIL_FROM=no-reply@dk-evenementiel.example

# Optionnel : envoyer les notifications de demande d'accès à une adresse fixe plutôt qu'à
# tous les super-administrateurs actifs.
ADMIN_NOTIFICATION_EMAIL=

# --- Synchronisation de data/evenements.csv vers GitHub après chaque import CSV ---
# Laissez GITHUB_TOKEN vide pour désactiver cette fonctionnalité (aucun impact sur le reste de
# l'appli). Jeton GitHub avec accès en écriture sur ce dépôt (fine-grained : permission
# "Contents: Read and write" limitée à ce dépôt ; ou un token classique avec le scope "repo").
GITHUB_TOKEN=
# Dépôt "owner/repo" et branche à mettre à jour.
GITHUB_REPO=dhagnere/DK_Evenementiel
GITHUB_BRANCH=main
# Chemin du fichier à synchroniser dans le dépôt.
GITHUB_CHEMIN_EVENEMENTS=data/evenements.csv

# --- Proxy de confiance ---
# Nombre de proxys devant l'application (1 derrière le routeur Scalingo). Valeur par défaut : 1 en
# production, 0 en développement.
# TRUST_PROXY=1

# --- Stockage des pièces jointes (stockage objet compatible S3) ---
# Le disque d'un conteneur Scalingo est effacé à chaque redémarrage : les fichiers déposés vont sur
# un stockage objet hébergé en France (Scaleway, OVHcloud, Outscale…). Laissez S3_BUCKET vide pour
# désactiver le dépôt de fichiers. Exemple Scaleway (Paris) :
#   S3_ENDPOINT=https://s3.fr-par.scw.cloud
#   S3_REGION=fr-par
S3_ENDPOINT=
S3_REGION=fr-par
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Préfixe des clés, pour partager un bucket entre recette et production (ex. recette/).
S3_PREFIXE=
